      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow2b_di" bpmnElement="flow2b">
        <omgdi:waypoint x="480" y="280" /><omgdi:waypoint x="540" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
        <omgdi:waypoint x="640" y="280" /><omgdi:waypoint x="700" y="280" />
